# Copy to .env (git-ignored) and fill in. The nexus CLI loads it automatically
# from the directory you run it in. Variables already set in your shell win.

# Use Claude through the company GateLLM gateway:
ANTHROPIC_BASE_URL=https://gatellm.sedintechnologies.com/api
ANTHROPIC_API_KEY=gatellm_live_your_key_here
# Claude models on the gateway (GET $ANTHROPIC_BASE_URL/v1/models): claude-opus-4-6, claude-sonnet-4-6, claude-haiku-4-5
NEXUS_MODEL=claude-opus-4-6

# Or Anthropic's API directly: remove ANTHROPIC_BASE_URL and use an Anthropic key.
