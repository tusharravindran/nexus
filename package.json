{
  "name": "nexus",
  "version": "0.1.0",
  "description": "Deterministic browser automation runtime built directly on the Chrome DevTools Protocol",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test \"test/unit/**/*.test.ts\"",
    "test:integration": "node --test --test-concurrency=1 \"test/integration/**/*.test.ts\"",
    "test": "npm run test:unit && npm run test:integration",
    "demo": "node examples/milestone1.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
